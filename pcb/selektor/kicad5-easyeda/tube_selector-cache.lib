# TubeSel_AudioConn
#
DEF TubeSel_AudioConn J 0 30 Y Y 1 F N
F0 "J" 50 200 50 H V C CNN
F1 "AudioConn" 50 -200 50 H V C CNN
F2 "" 0 0 50 H I C CNN
F3 "" 0 0 50 H I C CNN
DRAW
S -50 150 150 -150 0 1 10 f
X L 1 -200 100 150 R 50 50 1 1 P
X GND 2 -200 0 150 R 50 50 1 1 P
X R 3 -200 -100 150 R 50 50 1 1 P
ENDDRAW
ENDDEF
